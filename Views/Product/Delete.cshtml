@model Practical08.Models.Product

@{ 
    Layout = null;
}

<h2>Delete Product</h2>

<p>Are you sure you want to delete this product?</p>

<p><b>ID:</b> @Model.Id</p>
<p><b>Name:</b> @Model.Name</p>
<p><b>Description:</b> @Model.Description</p>
<p><b>Price:</b> @Model.Price</p>
<p><b>Quantity:</b> @Model.Quantity</p>
<p><b>Category:</b> @Model.Category</p>

@using (Html.BeginForm("Delete", "Product",
    new { id = Model.Id }, FormMethod.Post))
{
    @Html.AntiForgeryToken()

    <button type="submit" class="btn btn-danger">
        Confirm Delete
    </button>

    @Html.ActionLink("Cancel", "Index", null,
        new { @class = "btn btn-secondary" })
}
